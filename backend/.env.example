# imaginAI — Environment Variables
# Copy this file as .env and fill in your real values. Never share .env.

# ---- Gemini (Script Generation + TTS Multi-Key Failover) ----
# Single Primary Key:
GEMINI_API_KEY=your_primary_gemini_key_here

# Option A: Comma-separated list of keys for automatic failover
# GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10

# Option B: Individual numbered keys
# GEMINI_API_KEY_1=key1
# GEMINI_API_KEY_2=key2
# GEMINI_API_KEY_3=key3
# ... up to GEMINI_API_KEY_10

